{
    "manifest_version": 3,
    "name": "tone.ai",
    "version": "1.0",
    "description": "Select any text on the web and rewrite it in any tone instantly.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://web-production-b8b2d.up.railway.app/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_icon": "icons/icon48.png"
    }
}